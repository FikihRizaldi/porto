# ==========================================
# Comprehensive Git Ignore for PortoPro Monorepo
# ==========================================

# 1. Dependencies (Root, Frontend, Backend)
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Next.js & Frontend Build Outputs
.next/
**/.next/
out/
build/
dist/
.turbo/

# 3. Environment Secrets (DO NOT COMMIT REAL CREDENTIALS)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# 4. Backend Database & Storage (SQLite & Dynamic Data)
backend/data/*
!backend/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 5. User Uploaded Files (Dynamic media/PDFs/images)
backend/uploads/*
!backend/uploads/.gitkeep

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 7. TypeScript & Next.js Typings Cache
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# 8. Testing & Coverage
coverage/
cypress/videos/
cypress/screenshots/

# 9. Vercel & Deployment Caches
.vercel/

# 10. OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

.vercel
.env*
